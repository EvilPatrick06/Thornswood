 ],
 "builtBy": "scripts/dev/Build-WoodworkingBenches.py",
 "issue": 516,
 "keyword": "154e1:Thornswood-Content.esp",
 "readFrom": "game/data/last-plugin.json loadOrder, then Thornswood-Last.esp, Thornswood-WoodworkerTrail.esp; Thornswood-Content.esp, Thornswood-Last.esp, Thornswood-WoodworkerTrail.esp from game/content",
 "rule": "Each bench stands beside a forge, at offset (x to the smith's right, y the way the smith faces) and turn from the forge's winning record. Its outline (x -75 to 85, y 8 to 88) and its user's place (x -35 to 35, y -55 to 8) lie on the navmesh, on ground flat to 16 units and within 60 of the forge's height, and touch no furniture, container, door, item or static under 250 by 250 (larger statics, and anything over 600 units on a side, are the navmesh's), nor where anybody stands at another bench or the way through a door, from 6 to 140 units above the floor, with 30 units round the table. It stands on the lowest of those samples.",
 "skipped": {
  "dragonbridge": "its forge (531b:JKs Skyrim.esp) stands on sloping ground; the nearest clear flat spot is 725 units away out in the field, which is not beside a forge. The second forge, aa57 in Thornswood-Content.esp, was the other server's and left with its placements (#2553).",
  "ivarstead": "no forge and no anvil: no placed reference carrying CraftingSmithingForge stands in Ivarstead.",
  "rorikstead": "no forge of Skyrim's own. JK's Skyrim's anvil yard (62b1:JKs Skyrim.esp) sits on a raised ledge, and no clear flat ground of the bench's size lies within 640 units of it on that ledge.",
  "winterhold": "no forge: JK's Skyrim's smithing anvil (89c2:JKs Skyrim.esp) stands inside a shack of its own, and no clear flat ground of the bench's size lies within 640 units of it on its floor."
 }
