<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF on .NET 10, window and music drawn by WebView2 (index.html). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>wpf-net10-webview2</AssemblyName>
    <DefineConstants>$(DefineConstants);WEBVIEW</DefineConstants>
    <Nullable>disable</Nullable>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
