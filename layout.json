{
  "version": 2,
  "issue": 440,
  "note": "Where each place is in the repository, read by scripts/release/Where.ps1 and where.js. Version 1 also carried the old C:/Thornswood-Dev folder and the old tools paths as fallbacks for the reorganisation; those went on 28 September, when no machine had the old layout any more.",
  "places": {
    "Engine": "engine/skymp",
    "Out": "out",
    "Local": "local"
  },
  "derived": {
    "ServerDist": { "from": "Engine", "join": "build/dist/server" },
    "ClientDist": { "from": "Engine", "join": "build/dist/client" },
    "ServerSettings": { "from": "Engine", "join": "build/dist/server/server-settings.json" },
    "ChangeForms": { "from": "Engine", "join": "build/dist/server/world/changeForms" },
    "Dist": { "from": "Out", "join": "dist" },
    "Package": { "from": "Out", "join": "dist/Thornswood/_dist" },
    "Payload": { "from": "Out", "join": "_payload" },
    "ServerZip": { "from": "Out", "join": "thornswood-server.zip" },
    "Backups": { "from": "Local", "join": "backups" }
  },
  "folders": {
    "docs": "docs",
    "bot": "bot",
    "voice": "voice",
    "site": "site",
    "tests": "tests",
    "game": "game",
    "launcher": "launcher",
    "installer": "installer",
    "records": "records",
    "scripts": "scripts"
  }
}
