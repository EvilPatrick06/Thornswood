# Thornswood, the one door on 443.
#
# This is the reference copy and it matches the live one as of 18 September.
# The live one is C:\Thornswood-Caddy\Caddyfile on the VPS. Setup-Domain.ps1
# sends this file (since 25 September, issue #543), so a new box gets exactly
# this; an edit made on the box by hand is lost the next time it runs, so make
# it here. It lived only on the box until 18 September, which meant the only
# record of how the site was reachable was the box itself.
#
# Caddy gets the certificate and renews it on its own. The email below is what
# Let's Encrypt writes to if one is about to lapse.
#
# Keep it in caddy fmt shape. `caddy fmt --overwrite .\Caddyfile` does it, and
# validate complains about the line if you do not.
#
# ---------------------------------------------------------------------------
# THE VOICE BLOCKS ARE THE ONLY WAY TO VOICE.
#
# The voice services listen on 127.0.0.1:7778 and 127.0.0.1:7789 only, and
# every client uses https://thornswood.net/voice and /voice-dev with wss for
# the socket. The three steps this block once listed are done: the clients
# build wss and nothing else, they went out, and the services bind loopback,
# the default since #1304. A join token and a Discord ticket only ever reach
# the service through here: it refuses one over plain http or ws, and Caddy
# marks what it carries with X-Forwarded-Proto https.
#
# handle_path strips the prefix, so /voice/health reaches the service as
# /health and everything it serves keeps working unchanged. Caddy carries a
# WebSocket upgrade through reverse_proxy without being told to, so the
# signalling socket needs nothing more than this. Take these blocks out
# (Setup-Domain.ps1 writes a Caddyfile without them) and voice is gone.
# ---------------------------------------------------------------------------
# THE BOX BLOCK IS HOW A CLOUD CLAUDE THREAD REACHES SSH (#2753).
#
# A cloud thread's proxy carries HTTPS only, so ssh from there goes inside a
# WebSocket on 443: /box/ goes to the bridge on 127.0.0.1:7790
# (scripts\vps\bridge\bridge.js, Install-Bridge.ps1), which opens one only
# for its token and joins it to the box's own sshd. A plain request there
# gets the bridge's 404, so the site's pages are untouched. Take it out and
# cloud threads lose the box; One's own ssh on port 22 does not go through it.
# ---------------------------------------------------------------------------
# THE BOX LOG IS WHERE A LOST /box/ REQUEST SHOWS (#3297).
#
# On 22 Oct 2026 an ssh from One gave up after ten seconds and neither sshd
# nor the bridge had seen it, and nothing recorded whether it reached Caddy.
# Every /box/ request now leaves one JSON line in data\logs\box.log, with
# its status, how long it took and its Cf-Ray, the id Cloudflare's own
# records of it go by, and connect.js says which stage it was waiting at. A
# line is written when the request ends, a WebSocket's when its session does.
# Nothing else the site serves is logged here (log_skip). No address: the
# visitor's (client_ip and the headers that carry it) and the token are taken
# out of each line, the way the bridge's own log keeps none. Caddy runs as
# LOCAL SERVICE and may write only under data, so it lives there. 1 MiB a
# file, five kept, the oldest dropped.
# ---------------------------------------------------------------------------
# THE GITHUB-APP BLOCK IS THE BOX ADMIN APP'S ONE-TIME SETUP (#3107).
#
# /github-app/ goes to the box's GitHub admin service on 127.0.0.1:7791
# (scripts\vps\admin\admin.js, Install-AdminService.ps1). Through here it
# shows only the App's setup pages, and only while Install-AdminService.ps1
# -Setup has armed them for an hour with a state nobody can guess; anything
# else, its work for github-admin.yml included, it answers with its plain
# 404 to whatever comes with X-Forwarded-For. Take it out and the App can
# still do its work, but a new one cannot be made.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# CLOUDFLARE IS THE FRONT DOOR (#2995).
#
# thornswood.net is proxied by Cloudflare, and the box's firewall takes 80 and
# 443 only from Cloudflare's ranges (scripts\vps\Set-WebFirewall.ps1), so a
# forged SYN from anywhere else gets no answer and the box stops reflecting
# the SYN flood it was getting. Every request then reaches Caddy from a
# Cloudflare address, so the servers block below believes Cloudflare, and
# nobody else, about who the visitor is (CF-Connecting-IP), and every
# reverse_proxy hands that address on as the one X-Forwarded-For hop. Without
# it Caddy would append Cloudflare's own address, and the site's and voice's
# per-address limits and the sign-in log would see a handful of Cloudflare
# addresses for everybody. A caller from outside the list is its own address
# whatever headers it sends. The list is scripts\deploy\cloudflare-ranges.txt,
# kept equal to this line by tests\test-2995-cloudflare-front.ps1.
# ---------------------------------------------------------------------------
{
	email 187923600+EvilPatrick06@users.noreply.github.com
	storage file_system C:/Thornswood-Caddy/data
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

thornswood.net, www.thornswood.net {
	encode gzip

	log {
		output file C:/Thornswood-Caddy/data/logs/box.log {
			roll_size 1MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>client_ip delete
				request>headers>Cf-Connecting-Ip delete
				request>headers>X-Forwarded-For delete
				request>headers>True-Client-Ip delete
				request>headers>Cf-Ipcountry delete
				request>headers>Authorization delete
			}
		}
	}
	@notbox not path /box/*
	log_skip @notbox

	handle_path /voice/* {
		reverse_proxy 127.0.0.1:7778 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle_path /voice-dev/* {
		reverse_proxy 127.0.0.1:7789 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle_path /box/* {
		reverse_proxy 127.0.0.1:7790 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle_path /github-app/* {
		reverse_proxy 127.0.0.1:7791 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	reverse_proxy 127.0.0.1:3001 {
		header_up X-Forwarded-For {client_ip}
	}
}
