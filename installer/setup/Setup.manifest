<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- The setup program's manifest (Thornswood-Setup.exe, issue #463). Until
       then it carried csc's default one: asInvoker, but named MyApplication.app
       at 1.0.0.0, with no DPI awareness, so Windows stretched its window blurry
       at any scale above 100 percent.
       The version here is a placeholder. Setup.csproj's ThornswoodManifest
       target writes the launcher's version (Updater.cs Version, four parts)
       into a copy of this file and embeds that copy, the same number as the file's version
       details. tests\test-app-manifest.ps1 reads it back out of the built exe. -->
  <assemblyIdentity
    type="win32"
    name="Thornswood.Installer.Setup"
    version="0.0.0.0"
    processorArchitecture="*" />
  <!-- asInvoker, and it has to stay: the installer never asks for
       administrator. Windows guesses that an exe with "Setup" in its name
       without this line is an installer that needs administrator, and asks. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <!-- Windows Vista -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- The same as the launcher's: PerMonitorV2 on Windows 10 1703 and
           later, system aware (not the per-monitor legacy form) before it. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
</assembly>
