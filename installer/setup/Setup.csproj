<?xml version="1.0" encoding="utf-8"?>
<!--
  The setup program as an MSBuild project (issue #498). Since the switch
  (15 Oct) this is the only way it is built: scripts\release\Build-Launcher.ps1
  runs MSBuild on it. It holds Bootstrap.cs, the launcher's WindowFit.cs
  and the launcher's Themes.cs (the window is drawn in Forge, #2851), the
  emblem as logo.png, the launcher's icon, Setup.manifest stamped with
  the launcher's version, and
  FileVersion and ProductVersion from Updater.cs. Title, Product, Company and
  Copyright stay in Bootstrap.cs.

  It is called Thornswood-Setup, the name it ships under, because Windows
  reads OriginalFilename and InternalName from the name it was built as; the
  build then puts it at out\setup-stub.exe, which packaging copies from.

  Built the way launcher\app\Thornswood.csproj is, for the same reasons:
  that file's header has them.
-->
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ThornswoodRepo>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</ThornswoodRepo>
    <BaseIntermediateOutputPath>$(ThornswoodRepo)out\obj\setup\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Thornswood-Setup</AssemblyName>
    <RootNamespace>Thornswood</RootNamespace>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <LangVersion>13.0</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Optimize>true</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>pdbonly</DebugType>
    <NoConfig>true</NoConfig>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <HighEntropyVA>false</HighEntropyVA>
    <SubsystemVersion>4.00</SubsystemVersion>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <OutDir Condition="'$(OutDir)' == ''">$(ThornswoodRepo)out\setup\</OutDir>
    <OutputPath>$(OutDir)</OutputPath>
    <ApplicationIcon>..\..\launcher\app.ico</ApplicationIcon>
    <ApplicationManifest>$(BaseIntermediateOutputPath)ThornswoodSetup.stamped.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <ThornswoodVersionLine>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(ThornswoodRepo)launcher\app\Updater.cs')), 'Version\s*=\s*"[0-9.]+"'))</ThornswoodVersionLine>
    <ThornswoodVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(ThornswoodVersionLine)', '[^0-9.]', ''))</ThornswoodVersion>
    <ThornswoodVersion Condition="'$(ThornswoodVersion)' == ''">1.0.0</ThornswoodVersion>
    <ThornswoodVersionFour>$(ThornswoodVersion)</ThornswoodVersionFour>
    <ThornswoodVersionFour Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ThornswoodVersionFour)', '^[0-9]+$'))">$(ThornswoodVersionFour).0</ThornswoodVersionFour>
    <ThornswoodVersionFour Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ThornswoodVersionFour)', '^[0-9]+\.[0-9]+$'))">$(ThornswoodVersionFour).0</ThornswoodVersionFour>
    <ThornswoodVersionFour Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ThornswoodVersionFour)', '^[0-9]+\.[0-9]+\.[0-9]+$'))">$(ThornswoodVersionFour).0</ThornswoodVersionFour>
    <ThornswoodSetupVersionFile>$(BaseIntermediateOutputPath)ThornswoodSetupVersion.cs</ThornswoodSetupVersionFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Bootstrap.cs" />
    <Compile Include="..\..\launcher\app\WindowFit.cs"><Link>WindowFit.cs</Link></Compile>
    <Compile Include="..\..\launcher\app\Themes.cs"><Link>Themes.cs</Link></Compile>
    <Compile Include="$(ThornswoodSetupVersionFile)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\launcher\logo-192.png"><LogicalName>logo.png</LogicalName></EmbeddedResource>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <Target Name="ThornswoodCheckInputs" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('%(EmbeddedResource.FullPath)')" Text="%(EmbeddedResource.Identity) is not in the repository folder where it should be. It is tracked, so the path is wrong; nothing was built." />
    <Error Condition="'$(ThornswoodVersionLine)' == ''" Text="launcher\app\Updater.cs has no Version = &quot;...&quot; line, so the setup program would carry no version." />
  </Target>

  <Target Name="ThornswoodSetupVersion" BeforeTargets="CoreCompile" DependsOnTargets="ThornswoodCheckInputs">
    <ItemGroup>
      <ThornswoodSetupVersionLine Include="[assembly: System.Reflection.AssemblyVersion(&quot;$(ThornswoodVersionFour)&quot;)]" />
      <ThornswoodSetupVersionLine Include="[assembly: System.Reflection.AssemblyFileVersion(&quot;$(ThornswoodVersionFour)&quot;)]" />
      <ThornswoodSetupVersionLine Include="[assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(ThornswoodVersion)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(ThornswoodSetupVersionFile)" Lines="@(ThornswoodSetupVersionLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="ThornswoodManifest" BeforeTargets="ResolveKeySource;PrepareForBuild" DependsOnTargets="ThornswoodCheckInputs">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Setup.manifest" DestinationFiles="$(ApplicationManifest)" />
    <XmlPoke XmlInputPath="$(ApplicationManifest)" Query="/asm:assembly/asm:assemblyIdentity/@version" Value="$(ThornswoodVersionFour)" Namespaces="&lt;Namespace Prefix='asm' Uri='urn:schemas-microsoft-com:asm.v1' /&gt;" />
  </Target>
</Project>
