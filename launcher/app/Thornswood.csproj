<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The launcher (#4823): Avalonia on .NET 10, Windows only, compiled to
    native code and self-contained, so it needs nothing installed on the PC.
    Decided by Patrick on 27 Oct 2026 (docs/studies/launcher-stack/README.md):
    measured on One, the native build starts in 0.5 seconds in one process,
    against 3.7 seconds and eight processes for the WPF launcher it replaces.

    The window is compiled XAML (MainWindow.axaml): a renamed control is a
    build error, and every binding is compiled.

    Build it (from the repository folder, in PowerShell 7):
      .\scripts\release\Build-Launcher.ps1
    which publishes this project for win-x64 with Native AOT. A plain
    `dotnet build` builds it with the JIT, on any machine, for the checks.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>Thornswood</AssemblyName>
    <RootNamespace>Thornswood</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <!-- Thornswood.manifest with this build's version, written by
         ThornswoodManifest below (#463). -->
    <ApplicationManifest>$(BaseIntermediateOutputPath)Thornswood.stamped.manifest</ApplicationManifest>
    <Product>Thornswood</Product>
    <Company>Thornswood</Company>
    <Copyright>Thornswood</Copyright>
    <AssemblyTitle>Thornswood</AssemblyTitle>
    <Description>Thornswood launcher</Description>
    <!-- The number comes from the build (LauncherVersion.ps1, #5227):
         Build-Launcher.ps1 passes -p:Version. A bare build is 0.0.0. -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Turns on the trim and native-code analyzers in every build, so code
         that would break in the native exe (reflection, a serializer that
         reads types at run time, marshalling made at run time) is a warning
         on a plain `dotnet build` too, not only when Build-Launcher.ps1
         publishes. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- The menu theme's MP3 decoder (MenuMusic.cs), MIT, THIRD-PARTY.md. -->
    <PackageReference Include="NLayer" Version="3.0.0" />
    <!-- DPAPI for the keys the launcher keeps on this PC (Secrets.cs); on
         .NET Framework ProtectedData was part of the framework. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <!-- Voice without a browser (#4823, Voice*.cs). Opus in C# (Concentus,
         BSD-3-Clause), and DTLS-SRTP (SharpSRTP, MIT) on BouncyCastle (MIT).
         All three rooted whole in a Native AOT publish give no trim or AOT
         warning (measured 1 Nov 2026). THIRD-PARTY.md has their notices. -->
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="SharpSRTP" Version="0.5.8" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- Installs and updates the launcher, and carries the game files on the
         same channel (#4825). The same version as the vpk that packs it in
         .github/workflows/merge-release.yml (VPK_VERSION). -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Every resource under the name the code asks for. -->
  <ItemGroup>
    <EmbeddedResource Include="..\logo.png"><LogicalName>logo.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\logo-dev.png"><LogicalName>logo-dev.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\launcher-header.jpg"><LogicalName>launcher-header.jpg</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\launcher-header.webp"><LogicalName>launcher-header.webp</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\app.ico"><LogicalName>app.ico</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\app-dev.ico"><LogicalName>app-dev.ico</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\Thornswood.ini"><LogicalName>Thornswood.ini</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\records\client-build.json"><LogicalName>client-build.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\records\skyrim-files.json"><LogicalName>skyrim-files.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\records\ui-gone.json"><LogicalName>ui-gone.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\records\generated.json"><LogicalName>generated.json</LogicalName></EmbeddedResource>
  </ItemGroup>

  <!-- The application manifest (#463) with this build's version, four parts,
       in assemblyIdentity, stamped on every build, so the identity Windows
       reads is the number the launcher reports and can never sit at the
       placeholder. The native publish carries the assembly's manifest into
       the exe. tests\test-app-manifest.ps1 reads it back. -->
  <Target Name="ThornswoodManifest" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ThornswoodVersionFour>$(Version)</ThornswoodVersionFour>
      <ThornswoodVersionFour Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ThornswoodVersionFour)', '^[0-9]+\.[0-9]+\.[0-9]+$'))">$(ThornswoodVersionFour).0</ThornswoodVersionFour>
    </PropertyGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ThornswoodVersionFour)', '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'))"
           Text="The launcher's version is '$(Version)', which is not three or four numbers, so the application manifest cannot carry it (#463)." />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Thornswood.manifest" DestinationFiles="$(ApplicationManifest)" />
    <XmlPoke XmlInputPath="$(ApplicationManifest)" Query="/asm:assembly/asm:assemblyIdentity/@version" Value="$(ThornswoodVersionFour)"
             Namespaces="&lt;Namespace Prefix='asm' Uri='urn:schemas-microsoft-com:asm.v1' /&gt;" />
  </Target>
</Project>
