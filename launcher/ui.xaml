                      <TextBlock x:Name="TxtOwnGameState" Style="{StaticResource Small}" Margin="0,8,0,0"/>
                      <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                        <Button x:Name="BtnOwnGameMake" Style="{StaticResource Ghost}" Content="Make it"/>
                      </StackPanel>
                      <!-- Bring it up to date from Vortex moved to Diagnostics, Scan and Fix (#607). -->
                      <TextBlock Style="{StaticResource Small}" Margin="0,13,0,0" Text="The launcher finds the folder Vortex deploys into when it is in a Steam library. If it is somewhere else, choose it here: in Vortex, Mods, Open, Open Game Folder shows which one. Only the files Vortex lists in it are used, and the game itself always comes from the Steam copy."/>
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BtnOwnGamePick" Style="{StaticResource Ghost}" Content="Choose Vortex's folder" Margin="0,0,8,0"/>
                        <Button x:Name="BtnOwnGameForget" Style="{StaticResource Ghost}" Content="Forget the chosen folder"/>
                      </StackPanel>

                      <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,22,0,22"/>
                    </StackPanel>

                    <!-- Repair, Restore Windows folders and Refresh the shortcut icon
                         moved to Diagnostics, Scan and Fix (#607). -->

                    <!-- The dev-build card moved to the Server dropdown on the Play
                         page (#605). Choosing the dev server there installs or opens
                         the dev build, after the same Discord role check. -->

                    <TextBlock Style="{StaticResource H2}" Text="Uninstall Thornswood"/>
                    <TextBlock Style="{StaticResource Body}" Text="Puts your Windows Skyrim folders back, then deletes this build and the launcher with it. Your own Skyrim in Steam is never touched: this is a separate copy and Steam does not know it exists. There is no undo, and the whole thing has to be downloaded again afterwards."/>
                    <CheckBox x:Name="ChkDeleteMods" Content="Delete Thornswood's copy of the game as well" Margin="0,13,0,0" IsChecked="True"/>
                    <TextBlock Style="{StaticResource Small}" Margin="28,6,0,0" Text="This is Thornswood's own Game folder, built from what Vortex deployed. It is not the mods themselves and it is not your Skyrim in Steam, neither of which this can touch: taking the mods off is Purge in Vortex and nothing here does it for you. Untick this and the folder stays exactly where it is, so reinstalling reuses what is already on the disk instead of pulling the collection down again, which is the difference between a few minutes and an evening."/>
                    <CheckBox x:Name="ChkKeepSaves" Content="Keep this build's saves and settings" Margin="0,13,0,0" IsChecked="True"/>
                    <TextBlock Style="{StaticResource Small}" Margin="28,6,0,0" Text="Leaves the Profile folder where it is, so a reinstall picks your characters and settings back up."/>
                    <Button x:Name="BtnUninstall" Style="{StaticResource Ghost}" Content="Uninstall Thornswood" HorizontalAlignment="Left" Margin="0,15,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

        </Grid>
      </Grid>

      <!-- ================= status bar ================= -->
      <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
        <Grid Margin="20,0">
          <TextBlock x:Name="TxtStatus" Style="{StaticResource Mono}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,180,0"/>
          <TextBlock x:Name="TxtStatusRight" Style="{StaticResource Mono}" Foreground="{DynamicResource Faint}" FontSize="11"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
      </Border>

      <!-- The Overlay and OverlayHost that held the trade and town dialog over
           the whole window were here until 20 September. There is no dialog:
           you pick your character at the game's main menu. -->

    </Grid>
  </Border>
</Window>
