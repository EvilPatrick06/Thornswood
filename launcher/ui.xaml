<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thornswood" Width="1220" Height="800" MinWidth="1020" MinHeight="670"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="Manual"
        Background="#100D0A" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">

  <!-- ===========================================================
       Everything visual lives here. Themes.cs replaces these
       brushes by name at runtime, so nothing below holds a literal
       colour and a theme can change while the window is open.

       Type: Constantia for display, with small caps where the font
       has them. Segoe UI for everything read in sentences. Cascadia
       Mono, falling back to Consolas, for anything that lines up in
       a column. All three ship with Windows, so a friend's machine
       never falls back to something ugly.
       =========================================================== -->
  <Window.Resources>
    <SolidColorBrush x:Key="Bg"         Color="#100D0A"/>
    <SolidColorBrush x:Key="Panel"      Color="#171310"/>
    <SolidColorBrush x:Key="Card"       Color="#1D1813"/>
    <SolidColorBrush x:Key="CardHover"  Color="#262019"/>
    <SolidColorBrush x:Key="Deep"       Color="#0A0807"/>
    <SolidColorBrush x:Key="Line"       Color="#2C251D"/>
    <SolidColorBrush x:Key="Edge"       Color="#3A3126"/>
    <SolidColorBrush x:Key="Ink"        Color="#EDE5D8"/>
    <SolidColorBrush x:Key="Muted"      Color="#A79A88"/>
    <SolidColorBrush x:Key="Faint"      Color="#998772"/>
    <SolidColorBrush x:Key="Accent"     Color="#C8763A"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#3CC8763A"/>
    <SolidColorBrush x:Key="AccentInk"  Color="#1B1205"/>
    <SolidColorBrush x:Key="Ok"         Color="#7A9A55"/>
    <SolidColorBrush x:Key="Warn"       Color="#C79A3E"/>
    <SolidColorBrush x:Key="Bad"        Color="#CD6F5B"/>

    <!-- A forged surface, not a flat one. Neutral grey at low alpha so it
         reads the same amount on a dark theme and a light one. -->
    <DrawingBrush x:Key="Hatch" TileMode="Tile" Viewport="0,0,9,9" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry>
            <LineGeometry StartPoint="0,9" EndPoint="9,0"/>
          </GeometryDrawing.Geometry>
          <GeometryDrawing.Pen><Pen Brush="#16808080" Thickness="1"/></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="th" Background="{DynamicResource Line}" CornerRadius="5" Margin="3,0"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="th" Property="Background" Value="{DynamicResource Faint}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================================================ type -->
    <Style x:Key="Display" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Constantia, Georgia, Times New Roman"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontSize" Value="27"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="Typography.Capitals" Value="SmallCaps"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Constantia, Georgia, Times New Roman"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Constantia, Georgia, Times New Roman"/>
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Typography.Capitals" Value="SmallCaps"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="Margin" Value="0,0,0,11"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19.5"/>
    </Style>
    <Style x:Key="Small" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="17"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <!-- ================================================ chrome -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              </Trigger>
              <!-- Keyboard focus is drawn the same as hover, so a person
                   moving through the chrome buttons with Tab can see where
                   they are (#602). -->
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Nav" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="g" Background="Transparent">
              <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Fill="Transparent"/>
              <ContentPresenter VerticalAlignment="Center" Margin="22,0,14,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="g" Property="Background" Value="{DynamicResource Card}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              </Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="g" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter TargetName="bar" Property="Fill" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <!-- Tabbing to a nav item lights its accent bar, so keyboard
                   focus is as plain to see as the page it is on (#602). -->
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bar" Property="Fill" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavGroup" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Constantia, Georgia, Times New Roman"/>
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Typography.Capitals" Value="SmallCaps"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="Margin" Value="25,16,0,6"/>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <!-- Keyboard focus lights the accent border, the same edge
                   hover gives, so a Tab lands somewhere a person can see (#602). -->
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
              <!-- A link in focus reads in the accent, so Tab shows it the
                   same way the pointer does (#602). -->
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="FontFamily" Value="Constantia, Georgia, Times New Roman"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="Typography.Capitals" Value="SmallCaps"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="b" Background="{DynamicResource Accent}" CornerRadius="2"/>
              <!-- The Play button as a progress bar (#1145): how far an update,
                   the game folder or a file check has got, left to right, the
                   accent faded with a solid accent line along the bottom.
                   Hidden unless ShellProgress.cs shows it; it sets the width,
                   and slides a quarter width band while the total is unknown. -->
              <Grid x:Name="fill" HorizontalAlignment="Left" Width="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="{DynamicResource Accent}" Opacity="0.4" CornerRadius="2"/>
                <Border Height="3" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" CornerRadius="0,0,2,2"/>
              </Grid>
              <Rectangle Height="1" VerticalAlignment="Top" Margin="1,1,1,0" Fill="#33FFFFFF"/>
              <!-- The focus ring sits on top of the accent fill, drawn in the
                   ink that reads on it, and shows only when the button is
                   reached by keyboard (#602). -->
              <Rectangle x:Name="ring" RadiusX="2" RadiusY="2" Margin="3" Visibility="Collapsed"
                         Stroke="{DynamicResource AccentInk}" StrokeThickness="1.5" StrokeDashArray="2 2"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/>
                <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Solid" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="20,9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="sb" Background="{DynamicResource Accent}" CornerRadius="2">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
              </Border>
              <!-- Shown only on keyboard focus, in the ink that reads on the
                   accent fill, so Tab lands somewhere visible (#602). -->
              <Rectangle x:Name="ring" RadiusX="2" RadiusY="2" Margin="3" Visibility="Collapsed"
                         Stroke="{DynamicResource AccentInk}" StrokeThickness="1.5" StrokeDashArray="2 2"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="sb" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="sb" Property="Background" Value="{DynamicResource Card}"/>
                <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Deep}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="fb" Background="{TemplateBinding Background}" CornerRadius="2"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="fb" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A slider in the launcher's own colours: a thin line, the filled part
         in the accent, a round thumb. WPF's stock slider is a grey Windows
         control and would be the one thing on the page that is not ours. -->
    <Style x:Key="ThornSlider" TargetType="Slider">
      <Setter Property="Height" Value="22"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid>
              <Border Height="3" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource Line}"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="3" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource Accent}"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="22" Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{DynamicResource Ink}" Stroke="{DynamicResource Accent}" StrokeThickness="1.5"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="17" Height="17" Margin="0,0,11,0" VerticalAlignment="Center" CornerRadius="2"
                      Background="{DynamicResource Deep}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Path x:Name="tick" Data="M 3.4,8 L 6.6,11.3 L 12.8,4.2" Stroke="{DynamicResource AccentInk}"
                      StrokeThickness="1.9" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <!-- Keyboard focus lights the box edge, the same as hover, so a
                   person tabbing through the settings can see the tick they
                   are about to toggle (#602). -->
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Slab" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Padding" Value="18,16"/>
    </Style>

    <Style x:Key="Well" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Deep}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Padding" Value="15,13"/>
    </Style>
  </Window.Resources>

  <!-- The window draws its own title bar. Without WindowChrome, WindowStyle None
       with a resizable window shows the system resize border as a light strip
       along the top edge (#596). The edges still resize the window. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border x:Name="WindowFrame" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Bg}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>

      <!-- ================= title bar ================= -->
      <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Panel}">
        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line}"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
          <Rectangle Width="3" Height="15" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock x:Name="TxtPageTitle" Style="{StaticResource Eyebrow}" FontSize="15"
                     Foreground="{DynamicResource Ink}" Margin="0" VerticalAlignment="Center" Text="Play"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- Status chip lives on the Play server button now. Names kept so
               Shell.cs lookups still resolve; collapsed so the title bar stays clean. -->
          <Border x:Name="TitleServerChip" Style="{StaticResource Slab}" Padding="12,5" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="DotServer" Width="7" Height="7" Fill="{DynamicResource Faint}" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <TextBlock x:Name="TxtServer" Style="{StaticResource Mono}" Foreground="{DynamicResource Ink}" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Text="   " />
              <TextBlock x:Name="TxtPing" Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnMin"  Style="{StaticResource Chrome}" Content="&#x2013;"/>
          <Button x:Name="BtnMax"  Style="{StaticResource Chrome}" Content="&#x2610;"/>
          <Button x:Name="BtnClose" Style="{StaticResource Chrome}" Content="&#x2715;"/>
        </StackPanel>
      </Grid>

      <!-- ================= body ================= -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="208"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
              <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="20,10,18,10"/>
              <!-- Discord account sits above Settings: username, profile picture,
                   Reconnect only. No Forget, no headers, no how-it-works notes. -->
              <StackPanel x:Name="DiscordCard" Margin="18,2,14,10">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="DiscordAvatar" Width="32" Height="32" Margin="0,0,10,0"
                           VerticalAlignment="Center" Fill="{DynamicResource Line}"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LabelDiscord" FontSize="12.5"
                               Foreground="{DynamicResource Ink}" Text="Not linked"
                               TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                    <Button x:Name="ButtonDiscord" Style="{StaticResource Link}"
                            Content="Connect Discord" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <Button x:Name="NavSettings" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 0.5,3.5 H 14.5 M 0.5,11.5 H 14.5 M 5,3.5 A 1.6,1.6 0 1 0 5.01,3.5 M 10,11.5 A 1.6,1.6 0 1 0 10.01,11.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Settings" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <StackPanel Margin="25,12,18,0">
                <TextBlock x:Name="TxtVersion" Style="{StaticResource Mono}" Foreground="{DynamicResource Faint}" FontSize="10.5"/>
                <TextBlock x:Name="TxtBuildLine" Style="{StaticResource Mono}" Foreground="{DynamicResource Faint}" FontSize="10.5" Margin="0,3,0,0"/>
                <!-- The SkyMP source offer, where everybody who connects
                     starts (#421, AGPL section 13). -->
                <Button x:Name="BtnSource" Style="{StaticResource Link}" FontSize="10.5"
                        Content="Source code" HorizontalAlignment="Left" Margin="0,3,0,0"/>
              </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="22,16,18,0">
                  <Image x:Name="EmblemSmall" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center"
                         RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                  <TextBlock x:Name="TxtBrandSmall" Text="Thornswood" FontFamily="Constantia, Georgia" FontSize="17"
                             Typography.Capitals="SmallCaps" TextOptions.TextFormattingMode="Ideal"
                             TextWrapping="Wrap" TextAlignment="Center"
                             Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                </StackPanel>
                <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="22,16,18,0"/>
                <TextBlock Text="Session" Style="{StaticResource NavGroup}"/>
              <Button x:Name="NavPlay" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 2,1 L 13,7.5 L 2,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <TextBlock Text="Play" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavGallery" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 1.5,2.5 H 13.5 V 12.5 H 1.5 Z M 1.5,9.5 H 13.5 M 5.5,2.5 V 9.5 M 10.5,2.5 V 9.5"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Gallery" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavNews" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 1.5,2 H 13.5 V 13 H 1.5 Z M 3.5,5 H 11.5 M 3.5,7.5 H 11.5 M 3.5,10 H 8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="News" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavServer" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 1.5,2.5 H 13.5 V 6 H 1.5 Z M 1.5,9 H 13.5 V 12.5 H 1.5 Z M 3.6,4.2 H 4.4 M 3.6,10.7 H 4.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Server" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
                <!-- The whole of "Your build" (Mods, What is installed, Saves)
                     is hidden now, so its heading is too (issue #599). The
                     buttons themselves are collapsed in Shell.cs rather than
                     cut here, because navButtons/pages/PageTitles are parallel
                     arrays indexed by number and renumbering them is the bug
                     the PageXxx comment warns about. -->
                <TextBlock Text="Your build" Style="{StaticResource NavGroup}" Visibility="Collapsed"/>
              <Button x:Name="NavMods" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 7.5,0.5 L 14.5,4.2 L 7.5,7.9 L 0.5,4.2 Z M 0.5,7.6 L 7.5,11.3 L 14.5,7.6 L 7.5,3.9 Z M 0.5,11 L 7.5,14.7 L 14.5,11 L 7.5,7.3 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <TextBlock Text="Mods" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavBuild" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 7.5,1 L 14,4.6 V 10.4 L 7.5,14 L 1,10.4 V 4.6 Z M 1,4.6 L 7.5,8.2 L 14,4.6 M 7.5,8.2 V 14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="What is installed" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavSaves" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 1.5,1.5 H 11 L 13.5,4 V 13.5 H 1.5 Z M 4.5,1.5 V 6 H 10.5 V 1.5 M 4,9.5 H 11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Saves" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
                <TextBlock Text="When it breaks" Style="{StaticResource NavGroup}"/>
              <Button x:Name="NavControls" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 1,4 H 14 V 11.4 H 1 Z M 3.2,6.4 H 4.2 M 5.8,6.4 H 6.8 M 8.4,6.4 H 9.4 M 11,6.4 H 12 M 4.4,9.2 H 10.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Controls" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavLogs" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 1,3 H 14 M 1,7.5 H 14 M 1,12 H 9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Logs" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavDiag" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 1,8 H 4.2 L 6,3.4 L 9,12.6 L 10.8,8 H 14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Diagnostics" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavHelp" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 4.6,4.8 A 3,3 0 1 1 7.6,8.4 L 7.6,10.2 M 7.6,12.6 L 7.6,13.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Help" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1">

          <!-- ================ PLAY ================ -->
          <Grid x:Name="PagePlay">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="100" MaxHeight="100" ClipToBounds="True"
                    Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
              <Grid>
                <Rectangle Fill="{StaticResource Hatch}" Opacity="0.85"/>
                <!-- The landscape behind the title, filled in from Art.Header().
                     The band's height is the title row's, 100 and no taller, and
                     the art never sets it: both layers are brushes on a Border,
                     so neither can push the row open. Both fill the band and crop
                     what does not fit (UniformToFill, centred), and both take the
                     same part of the art, Art.HeaderCrop, so the still and the
                     moving strip line up and the overlook keeps its approved
                     framing at any window width. Nothing on this band zooms,
                     drifts or runs fast.
                     Collapsed when the build carries no picture, which leaves the
                     pattern above exactly as it was. Every veil is the theme's own
                     panel colour, so a light theme washes the picture light and a
                     dark one dark. The two heavier veils are fixed widths anchored
                     to the sides, because the title and the figures are fixed
                     widths too: at any window size the text sits on a strong veil
                     and the picture shows most in the gap between them. -->
                <Grid x:Name="HeaderArt" Visibility="Collapsed" IsHitTestVisible="False">
                  <Border x:Name="HeaderArtPicture"/>
                  <!-- The same strip moving, from Art.HeaderVideo(), painted by a
                       brush the way the picture is so the two line up. Stays
                       collapsed when the build has no video or this machine cannot
                       play one, and the picture shows as it always did. -->
                  <Border x:Name="HeaderArtVideo" Visibility="Collapsed"/>
                  <Rectangle Fill="{DynamicResource Panel}" Opacity="0.45"/>
                  <Rectangle Fill="{DynamicResource Panel}" Width="520" HorizontalAlignment="Left">
                    <Rectangle.OpacityMask>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#B0000000" Offset="0"/>
                        <GradientStop Color="#B0000000" Offset="0.7"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                      </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                  </Rectangle>
                  <Rectangle Fill="{DynamicResource Panel}" Width="520" HorizontalAlignment="Right">
                    <Rectangle.OpacityMask>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#B0000000" Offset="0.3"/>
                        <GradientStop Color="#B0000000" Offset="1"/>
                      </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                  </Rectangle>
                </Grid>
                <!-- Fixed short landscape/stats strip: Height+MaxHeight lock to main
                     1.1.96 logo-band height. No MinHeight-only (image/video stretch
                     was expanding the Auto row). Logo and title stay collapsed. -->
                <Grid Margin="36,8,36,8" Height="84" MaxHeight="84">
                  <!-- Logo and title text over the hero art were clutter; collapsed so Shell lookups still resolve. -->
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Image x:Name="Emblem" Width="84" Height="84" Margin="0,0,22,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                    <StackPanel x:Name="BannerTitle" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtBrandBig" Text="Thornswood" Style="{StaticResource Display}"/>
                      <!-- The dash and the plugins / game / launcher line under the name are not shown
                           on the banner (#596). Kept in the tree because the code still fills the line. -->
                      <StackPanel Orientation="Horizontal" Margin="2,8,0,0" Visibility="Collapsed">
                        <Rectangle Width="26" Height="2" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtHeroLine" Style="{StaticResource Small}" FontSize="12" VerticalAlignment="Center"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                  <!-- Played / Sessions / Last played fill the strip evenly. Updated was removed. -->
                  <UniformGrid x:Name="StatRow" Columns="3" VerticalAlignment="Center">
                    <UniformGrid.Effect>
                      <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="8" Opacity="0.95"/>
                    </UniformGrid.Effect>
                  </UniformGrid>
                </Grid>
              </Grid>
            </Border>

            <!-- No ScrollViewer on Play: the page fits the normal launcher window. Other pages keep theirs.
                 Gallery fills the large empty centre; compact Ready sits on the right where Server used to. -->
            <Grid Grid.Row="1" Margin="36,20,36,10" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="28"/>
                  <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <!-- Rotating approved spotlight on Play. Filled by StartGallery in Shell.cs,
                     hidden until the first picture has loaded (#603). Staff and Report
                     tools are on the Gallery page, not here (#731). Pending never shows here. -->
                <Grid x:Name="GalleryCard" Grid.Column="0" ClipToBounds="True" Visibility="Collapsed">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="From the world" Style="{StaticResource Eyebrow}"/>
                  <Border Grid.Row="1" Style="{StaticResource Slab}" Padding="0" ClipToBounds="True"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Image x:Name="GalleryImage" Stretch="UniformToFill"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Border>
                  <!-- Byline only on Play. Report, Delete, Accept and upload
                       live on the Gallery page (#731). -->
                  <TextBlock x:Name="GalleryBy" Grid.Row="2" Style="{StaticResource Small}"
                             TextWrapping="Wrap" Margin="2,8,2,0"/>
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                  <!-- Compact Ready: smaller card in the old Server column, not a wide centre strip. -->
                  <TextBlock Text="Ready" Style="{StaticResource Eyebrow}"/>
                  <Border Style="{StaticResource Slab}" Padding="14,11">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Ellipse x:Name="DotReady" Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource Faint}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                      <TextBlock x:Name="TxtReadyTitle" Grid.Column="1" Text="Checking..."
                                 FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                                 TextWrapping="Wrap" VerticalAlignment="Center"/>
                      <!-- Kept collapsed; Shell still looks it up. Subtitle under the ready line is gone. -->
                      <TextBlock x:Name="TxtReadyNote" Visibility="Collapsed"/>
                      <Button x:Name="BtnCheckDiagnostics" Grid.Column="2" Style="{StaticResource Ghost}"
                              Content="Diagnostics" Margin="8,0,0,0" VerticalAlignment="Center" Padding="8,4"
                              Visibility="Collapsed"/>
                      <!-- Shown while Steam is not running (#3204). Its own row
                           under the words: beside Diagnostics in a 250 wide
                           column it would leave the words no room. -->
                      <Button x:Name="BtnOpenSteam" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                              Style="{StaticResource Ghost}" Content="Open Steam" Margin="0,8,0,0"
                              HorizontalAlignment="Left" Padding="8,4" Visibility="Collapsed"/>
                    </Grid>
                  </Border>

                  <!-- This card told a new person to name the character after
                       themselves and to save before connecting, both left over
                       from the old multiplayer mod. The name is what everybody sees over
                       your head in a roleplay world, so a person who followed the
                       card walked into Whiterun under their own name. And there is
                       no saving: the server holds the character. Help.cs gives the
                       same name rule in its Joining items, and
                       tools/test-first-run-words.js keeps the two saying the same
                       thing. -->
                  <StackPanel x:Name="FirstRunCard" Margin="0,18,0,0">
                    <TextBlock Text="First time" Style="{StaticResource Eyebrow}"/>
                    <Border Style="{StaticResource Slab}" Padding="14,12">
                      <StackPanel>
                        <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap"
                                   Text="Give your character a name that belongs in Skyrim: a first name and a family name or a byname, and not your own. That name is what other people see above your head, and it cannot be changed later without a new character."/>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel x:Name="QuickKeysCard" Visibility="Collapsed" Margin="0,18,0,0">
                    <TextBlock Text="In game" Style="{StaticResource Eyebrow}"/>
                    <Border Style="{StaticResource Slab}" Padding="14,12">
                      <StackPanel x:Name="QuickKeys"/>
                    </Border>
                    <Button x:Name="BtnAllControls" Style="{StaticResource Link}" Content="All of the controls"
                            HorizontalAlignment="Left" Margin="0,8,0,0"/>
                  </StackPanel>
                </StackPanel>
            </Grid>

            <Border x:Name="UpdateBar" Grid.Row="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1" CornerRadius="2" Padding="20,16" Margin="36,0,36,16" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock x:Name="TxtUpdateTitle" Style="{StaticResource H2}" Text="Update available"/>
                  <TextBlock x:Name="TxtUpdateNote" Style="{StaticResource Small}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnUpdate" Grid.Column="1" Style="{StaticResource Solid}" Content="Install now" VerticalAlignment="Center" Margin="18,0,0,0"/>
              </Grid>
            </Border>

            <!-- CharBar, the two character slots that opened under Play, sat here
                 until 20 September. You pick your character at the game's main
                 menu now, so Play starts the game. -->

            <Border x:Name="DowngradeBar" Grid.Row="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1" CornerRadius="2" Padding="20,16" Margin="36,0,36,16" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock x:Name="TxtDowngradeTitle" Style="{StaticResource H2}" Text="Skyrim is on the wrong build"/>
                  <TextBlock x:Name="TxtDowngradeNote" Style="{StaticResource Small}" Margin="0,2,0,0" TextWrapping="Wrap"
                             Text="The server runs 1.6.1170. Press the button: Steam downloads the 1.6.1170 files under your own account and the launcher puts them into Thornswood's own game folder. Your Steam copy of Skyrim is not changed. About 11 GB, and Steam has to be signed in."/>
                  <!-- How far the downgrade is: each part of three by the size Steam
                       gives for it, then the copy. Set through Downgrade.OnProgress
                       by RunDowngrade in Shell.cs; hidden until a run starts. -->
                  <ProgressBar x:Name="PrgDowngrade" Height="6" Minimum="0" Maximum="100" Margin="0,10,0,0"
                               Background="{DynamicResource Line}" Foreground="{DynamicResource Accent}" BorderThickness="0"
                               Visibility="Collapsed"/>
                </StackPanel>
                <Button x:Name="BtnDowngrade" Grid.Column="1" Style="{StaticResource Solid}" Content="Downgrade to 1.6.1170" VerticalAlignment="Center" Margin="18,0,0,0"/>
              </Grid>
            </Border>

            <!-- What the update feed says to everybody (To Do List entry 262): its
                 message, and the reason when it holds Play for maintenance or for
                 a launcher too old to play. A row of its own, so it can stand
                 under an update card without covering it; UpdateBar and
                 DowngradeBar share row 2 because DrawStatus keeps the downgrade
                 card down while an update card is up.
                 Filled in by ShowNotice in Shell.cs. -->
            <Border x:Name="NoticeBar" Grid.Row="3" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1" CornerRadius="2" Padding="20,16" Margin="36,0,36,16" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="TxtNoticeTitle" Style="{StaticResource H2}"/>
                <TextBlock x:Name="TxtNoticeNote" Style="{StaticResource Small}" Margin="0,2,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- Same columns as the Gallery | gap | Ready row above: PLAY under Gallery,
                 server chip under the Ready column. Recheck is gone; Diagnostics owns that path. -->
            <Grid Grid.Row="4" Margin="36,4,36,28">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="250"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="BtnPlay" Grid.Column="0" Style="{StaticResource Primary}" Content="Play"
                      HorizontalAlignment="Stretch"/>
              <Grid Grid.Column="2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnQuitGame" Grid.Column="0" Style="{StaticResource Ghost}" Content="Quit Skyrim" Margin="0,0,8,0" Visibility="Collapsed"/>
                <Grid x:Name="ServerPickCard" Grid.Column="1" HorizontalAlignment="Stretch">
                  <!-- One control open and closed. Closed: Ghost chip full width of the Ready
                       column. Open: Popup covers the chip (VerticalOffset = -chip height in
                       Shell) with one Border the exact chip width, both Main and Dev rows. -->
                  <Button x:Name="BtnServerPick" Style="{StaticResource Ghost}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Padding="10,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Ellipse x:Name="DotServerPick" Grid.Column="0" Width="7" Height="7"
                               Fill="{DynamicResource Faint}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtServerPick" Text="Main" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtServerPickMeta" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Muted}" FontSize="11"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="▾" Margin="12,0,0,0"
                                 VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                    </Grid>
                  </Button>
                  <Popup x:Name="ServerPickPopup" Placement="Bottom"
                         PlacementTarget="{Binding ElementName=BtnServerPick}"
                         HorizontalOffset="0" VerticalOffset="0"
                         StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
                    <Border x:Name="ServerPickPanel"
                            Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="2" Padding="4"
                            SnapsToDevicePixels="True">
                      <StackPanel>
                        <Button x:Name="BtnServerMain" Style="{StaticResource Ghost}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,2"
                                Padding="10,8">
                          <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotServerMain" Width="7" Height="7"
                                     Fill="{DynamicResource Faint}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="Main" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtServerMainMeta" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Muted}" FontSize="11"/>
                          </StackPanel>
                        </Button>
                        <Button x:Name="BtnServerDev" Style="{StaticResource Ghost}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="10,8">
                          <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotServerDev" Width="7" Height="7"
                                     Fill="{DynamicResource Faint}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="Dev" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtServerDevMeta" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Muted}" FontSize="11"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Border>
                  </Popup>
                </Grid>
                <Button x:Name="BtnCopy" Grid.Column="2" Style="{StaticResource Ghost}" Content="Copy address" Visibility="Collapsed"/>
              </Grid>
            </Grid>
          </Grid>

          <!-- ================ NEWS ================ -->
          <Grid x:Name="PageNews" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="NewsList" Margin="36,30,36,30" MaxWidth="840" HorizontalAlignment="Left"/>
            </ScrollViewer>
          </Grid>

          <!-- ================ SERVER ================ -->
          <Grid x:Name="PageServer" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="36,30,36,30" MaxWidth="900" HorizontalAlignment="Left">

                <Border Style="{StaticResource Slab}" Padding="24,22">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="The server" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                      <TextBlock x:Name="TxtSrvAddress" Style="{StaticResource Mono}" FontSize="21"
                                 Foreground="{DynamicResource Ink}"/>
                      <TextBlock x:Name="TxtSrvState" Style="{StaticResource Body}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="BtnSrvRetest" Style="{StaticResource Ghost}" Content="Test again" Margin="0,0,8,0"/>
                      <Button x:Name="BtnSrvCopy"   Style="{StaticResource Ghost}" Content="Copy address"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Style="{StaticResource Slab}" Padding="24,20" Margin="0,14,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Style="{StaticResource H2}" Text="Proximity voice"/>
                      <TextBlock x:Name="TxtVoiceState" Style="{StaticResource Small}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="BtnVoiceTest" Style="{StaticResource Ghost}" Content="Test again"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <TextBlock Text="Round trip" Style="{StaticResource Eyebrow}" Margin="0,30,0,11"/>
                <Border Style="{StaticResource Well}" Padding="18,16">
                  <StackPanel>
                    <Grid Height="74">
                      <StackPanel x:Name="SrvPingBars" Orientation="Horizontal" VerticalAlignment="Bottom"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,10,0,9"/>
                    <TextBlock x:Name="TxtSrvPingNote" Style="{StaticResource Small}"/>
                  </StackPanel>
                </Border>

