                <TextBlock Text="Scan and Fix" Style="{StaticResource Eyebrow}" Margin="0,0,0,11"/>
                <Border x:Name="VerifyCard" Style="{StaticResource Slab}" Padding="20,17">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse x:Name="DotVerify" Grid.Column="0" Width="10" Height="10" Fill="{DynamicResource Faint}"
                             VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="TxtVerifyTitle" Style="{StaticResource H2}" Text="Not checked yet"/>
                      <TextBlock x:Name="TxtVerifyNote" Style="{StaticResource Small}" Margin="0,2,0,0"
                                 Text="Looks for everything wrong with this install: your plugins against the server's, an update waiting, Thornswood's own folder and files, Windows' Skyrim folders, the shortcut icon, the client, Steam and the Skyrim build. Fix puts right what it can, then says what is left and what will put it right."/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                      <Button x:Name="BtnScan" Style="{StaticResource Ghost}" Content="Scan" Margin="0,0,8,0"/>
                      <Button x:Name="BtnFix"  Style="{StaticResource Solid}" Content="Fix" IsEnabled="False"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Ready to launch (kept). Mods / Mod list share Scan and Fix's Issue list. -->
                <TextBlock Text="Ready to launch" Style="{StaticResource Eyebrow}" Margin="0,30,0,11"/>
                <StackPanel x:Name="StatusList"/>

                <!-- Collection line: after the last Ready to launch row (Steam),
                     before Bring it up to date from Vortex. Built in C# so a
                     missing named control cannot take the page with it. -->
                <StackPanel x:Name="DiagCollection" Margin="0,8,0,0"/>

                <!-- The optional packs (#1170), under the collection line. Their
                     Add-ons tab is on the Mods page, which #599 took off the
                     rail. Built in C# like the collection line, and empty until
                     the update feed lists a pack. -->
                <StackPanel x:Name="DiagAddons"/>

                <!-- Bring it up to date from Vortex, Repair and Restore Windows
                     folders were buttons here until 17 Oct (#2627): Scan finds
                     each of those and Fix does it. The icon refresh stays,
                     because a blank picture Windows remembers for a shortcut
                     cannot be seen from the shortcut, so Scan cannot find it. -->
                <Border Style="{StaticResource Slab}" Padding="20,18" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Refresh the shortcut icon"/>
                    <TextBlock Style="{StaticResource Body}" Text="Scan and Fix point your shortcuts at the current artwork, and the launcher does it every time it starts. This is for when the desktop or the taskbar is still showing an old or blank icon anyway, which Windows keeps in a picture of its own that no shortcut shows. Explorer restarts, so the taskbar blinks once. Nothing is lost."/>
                    <Button x:Name="BtnIcons" Style="{StaticResource Ghost}" Content="Refresh icon" HorizontalAlignment="Left" Margin="0,13,0,0"/>
                  </StackPanel>
                </Border>

                <TextBlock Text="What the launcher can see right now" Style="{StaticResource Eyebrow}" Margin="0,30,0,11"/>
                <StackPanel x:Name="DiagReadings"/>

                <!-- Support zip: was the top card; kept at the bottom so Build the report still exists. -->
                <TextBlock Text="Support report" Style="{StaticResource Eyebrow}" Margin="0,30,0,11"/>
                <Border Style="{StaticResource Slab}" Padding="20,17">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Style="{StaticResource H2}" Text="One zip for Discord"/>
                      <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0"
                                 Text="Newest crash log, script extender log, plugin list, launcher log and a short machine summary. Nothing personal beyond your Windows user name in file paths."/>
                      <TextBlock x:Name="TxtDiagNote" Style="{StaticResource Small}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                      <Button x:Name="BtnDiagBundle" Style="{StaticResource Solid}" Content="Build the report"/>
                      <Button x:Name="BtnDiagOpen" Style="{StaticResource Ghost}" Content="Open the folder" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>


