                    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,15,0,15"/>
                    <TextBlock Style="{StaticResource Body}" Text="It does check your mod list. If yours does not match what this build shipped with, the server refuses the connection rather than letting you desync everyone. That check is the reason the launcher will not let you press Play with a broken list."/>
