                  <Button x:Name="BtnFolder"  Style="{StaticResource Ghost}" Content="Open install folder" Margin="0,0,8,0"/>
                  <Button x:Name="BtnOpenLog" Style="{StaticResource Ghost}" Content="Open log"/>
                </StackPanel>

                <TextBlock Text="Maintenance" Style="{StaticResource Eyebrow}"/>
                <Border Style="{StaticResource Slab}" Padding="20,18">
                  <StackPanel>
                    <StackPanel x:Name="PnlOwnGame">
                      <TextBlock Style="{StaticResource H2}" Text="Thornswood's own Skyrim folder"/>
