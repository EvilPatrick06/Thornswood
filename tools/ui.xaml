<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThornsWood" Width="1220" Height="800" MinWidth="1020" MinHeight="670"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="Manual"
        Background="#100D0A" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">

  <!-- ===========================================================
       Everything visual lives here. Themes.cs replaces these
       brushes by name at runtime, so nothing below holds a literal
       colour and a theme can change while the window is open.

       Type: Constantia for display, with small caps where the font
       has them. Segoe UI for everything read in sentences. Cascadia
       Mono, falling back to Consolas, for anything that lines up in
       a column. All three ship with Windows, so a friend's machine
       never falls back to something ugly.
       =========================================================== -->
  <Window.Resources>
    <SolidColorBrush x:Key="Bg"         Color="#100D0A"/>
    <SolidColorBrush x:Key="Panel"      Color="#171310"/>
    <SolidColorBrush x:Key="Card"       Color="#1D1813"/>
    <SolidColorBrush x:Key="CardHover"  Color="#262019"/>
    <SolidColorBrush x:Key="Deep"       Color="#0A0807"/>
    <SolidColorBrush x:Key="Line"       Color="#2C251D"/>
    <SolidColorBrush x:Key="Edge"       Color="#3A3126"/>
    <SolidColorBrush x:Key="Ink"        Color="#EDE5D8"/>
    <SolidColorBrush x:Key="Muted"      Color="#9C8D79"/>
    <SolidColorBrush x:Key="Faint"      Color="#66594A"/>
    <SolidColorBrush x:Key="Accent"     Color="#C8763A"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#3CC8763A"/>
    <SolidColorBrush x:Key="AccentInk"  Color="#1B1205"/>
    <SolidColorBrush x:Key="Ok"         Color="#7A9A55"/>
    <SolidColorBrush x:Key="Warn"       Color="#C79A3E"/>
    <SolidColorBrush x:Key="Bad"        Color="#BC5039"/>

    <!-- A forged surface, not a flat one. Neutral grey at low alpha so it
         reads the same amount on a dark theme and a light one. -->
    <DrawingBrush x:Key="Hatch" TileMode="Tile" Viewport="0,0,9,9" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry>
            <LineGeometry StartPoint="0,9" EndPoint="9,0"/>
          </GeometryDrawing.Geometry>
          <GeometryDrawing.Pen><Pen Brush="#16808080" Thickness="1"/></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="th" Background="{DynamicResource Line}" CornerRadius="5" Margin="3,0"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="th" Property="Background" Value="{DynamicResource Faint}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================================================ type -->
    <Style x:Key="Display" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Constantia, Georgia, Times New Roman"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontSize" Value="27"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="Typography.Capitals" Value="SmallCaps"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Constantia, Georgia, Times New Roman"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Constantia, Georgia, Times New Roman"/>
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Typography.Capitals" Value="SmallCaps"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="Margin" Value="0,0,0,11"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19.5"/>
    </Style>
    <Style x:Key="Small" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="17"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <!-- ================================================ chrome -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Nav" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="g" Background="Transparent">
              <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Fill="Transparent"/>
              <ContentPresenter VerticalAlignment="Center" Margin="22,0,14,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="g" Property="Background" Value="{DynamicResource Card}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              </Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="g" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter TargetName="bar" Property="Fill" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavGroup" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Constantia, Georgia, Times New Roman"/>
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Typography.Capitals" Value="SmallCaps"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="Margin" Value="25,16,0,6"/>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="FontFamily" Value="Constantia, Georgia, Times New Roman"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="Typography.Capitals" Value="SmallCaps"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="b" Background="{DynamicResource Accent}" CornerRadius="2"/>
              <Rectangle Height="1" VerticalAlignment="Top" Margin="1,1,1,0" Fill="#33FFFFFF"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/>
                <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Solid" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="20,9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="sb" Background="{DynamicResource Accent}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="sb" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="sb" Property="Background" Value="{DynamicResource Card}"/>
                <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Deep}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="fb" Background="{TemplateBinding Background}" CornerRadius="2"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="fb" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="17" Height="17" Margin="0,0,11,0" VerticalAlignment="Center" CornerRadius="2"
                      Background="{DynamicResource Deep}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Path x:Name="tick" Data="M 3.4,8 L 6.6,11.3 L 12.8,4.2" Stroke="{DynamicResource AccentInk}"
                      StrokeThickness="1.9" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Slab" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Padding" Value="18,16"/>
    </Style>

    <Style x:Key="Well" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Deep}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Padding" Value="15,13"/>
    </Style>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Bg}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>

      <!-- ================= title bar ================= -->
      <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Panel}">
        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line}"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
          <Rectangle Width="3" Height="15" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock x:Name="TxtPageTitle" Style="{StaticResource Eyebrow}" FontSize="15"
                     Foreground="{DynamicResource Ink}" Margin="0" VerticalAlignment="Center" Text="Play"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Border Style="{StaticResource Slab}" Padding="12,5" VerticalAlignment="Center" Margin="0,0,14,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="DotServer" Width="7" Height="7" Fill="{DynamicResource Faint}" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <TextBlock x:Name="TxtServer" Style="{StaticResource Mono}" Foreground="{DynamicResource Ink}" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Text="   " />
              <TextBlock x:Name="TxtPing" Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnMin"  Style="{StaticResource Chrome}" Content="&#x2013;"/>
          <Button x:Name="BtnMax"  Style="{StaticResource Chrome}" Content="&#x2610;"/>
          <Button x:Name="BtnClose" Style="{StaticResource Chrome}" Content="&#x2715;"/>
        </StackPanel>
      </Grid>

      <!-- ================= body ================= -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="208"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
              <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="20,10,18,10"/>
              <Button x:Name="NavSettings" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 0.5,3.5 H 14.5 M 0.5,11.5 H 14.5 M 5,3.5 A 1.6,1.6 0 1 0 5.01,3.5 M 10,11.5 A 1.6,1.6 0 1 0 10.01,11.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Settings" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <StackPanel Margin="25,12,18,0">
                <TextBlock x:Name="TxtVersion" Style="{StaticResource Mono}" Foreground="{DynamicResource Faint}" FontSize="10.5"/>
                <TextBlock x:Name="TxtBuildLine" Style="{StaticResource Mono}" Foreground="{DynamicResource Faint}" FontSize="10.5" Margin="0,3,0,0"/>
              </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="22,16,18,0">
                  <Image x:Name="EmblemSmall" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center"
                         RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                  <TextBlock x:Name="TxtBrandSmall" Text="ThornsWood" FontFamily="Constantia, Georgia" FontSize="17"
                             Typography.Capitals="SmallCaps" TextOptions.TextFormattingMode="Ideal"
                             Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                </StackPanel>
                <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="22,16,18,0"/>
                <TextBlock Text="Session" Style="{StaticResource NavGroup}"/>
              <Button x:Name="NavPlay" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 2,1 L 13,7.5 L 2,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <TextBlock Text="Play" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavNews" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 1.5,2 H 13.5 V 13 H 1.5 Z M 3.5,5 H 11.5 M 3.5,7.5 H 11.5 M 3.5,10 H 8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="News" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavServer" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 1.5,2.5 H 13.5 V 6 H 1.5 Z M 1.5,9 H 13.5 V 12.5 H 1.5 Z M 3.6,4.2 H 4.4 M 3.6,10.7 H 4.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Server" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
                <TextBlock Text="Your build" Style="{StaticResource NavGroup}"/>
              <Button x:Name="NavMods" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 7.5,0.5 L 14.5,4.2 L 7.5,7.9 L 0.5,4.2 Z M 0.5,7.6 L 7.5,11.3 L 14.5,7.6 L 7.5,3.9 Z M 0.5,11 L 7.5,14.7 L 14.5,11 L 7.5,7.3 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <TextBlock Text="Mods" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavBuild" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 7.5,1 L 14,4.6 V 10.4 L 7.5,14 L 1,10.4 V 4.6 Z M 1,4.6 L 7.5,8.2 L 14,4.6 M 7.5,8.2 V 14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="What is installed" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavSaves" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 1.5,1.5 H 11 L 13.5,4 V 13.5 H 1.5 Z M 4.5,1.5 V 6 H 10.5 V 1.5 M 4,9.5 H 11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Saves" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
                <TextBlock Text="When it breaks" Style="{StaticResource NavGroup}"/>
              <Button x:Name="NavControls" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 1,4 H 14 V 11.4 H 1 Z M 3.2,6.4 H 4.2 M 5.8,6.4 H 6.8 M 8.4,6.4 H 9.4 M 11,6.4 H 12 M 4.4,9.2 H 10.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Controls" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavLogs" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 1,3 H 14 M 1,7.5 H 14 M 1,12 H 9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Logs" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavDiag" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 1,8 H 4.2 L 6,3.4 L 9,12.6 L 10.8,8 H 14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Diagnostics" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavHelp" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 4.6,4.8 A 3,3 0 1 1 7.6,8.4 L 7.6,10.2 M 7.6,12.6 L 7.6,13.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                  <TextBlock Text="Help" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1">

          <!-- ================ PLAY ================ -->
          <Grid x:Name="PagePlay">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

