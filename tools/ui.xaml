<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skyrim Together" Width="1180" Height="760" MinWidth="1000" MinHeight="660"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#0E1216" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <SolidColorBrush x:Key="Bg"        Color="#0E1216"/>
    <SolidColorBrush x:Key="Panel"     Color="#141A20"/>
    <SolidColorBrush x:Key="Card"      Color="#182028"/>
    <SolidColorBrush x:Key="CardHover" Color="#1E2830"/>
    <SolidColorBrush x:Key="Line"      Color="#232E36"/>
    <SolidColorBrush x:Key="Ink"       Color="#E4EAEE"/>
    <SolidColorBrush x:Key="Muted"     Color="#7E8D97"/>
    <SolidColorBrush x:Key="Faint"     Color="#4E5A63"/>
    <SolidColorBrush x:Key="Accent"    Color="#C8763A"/>
    <SolidColorBrush x:Key="AccentInk" Color="#FFF3E8"/>
    <SolidColorBrush x:Key="Ok"        Color="#5C9C66"/>
    <SolidColorBrush x:Key="Warn"      Color="#B9903F"/>
    <SolidColorBrush x:Key="Bad"       Color="#B8483C"/>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource Line}" CornerRadius="4" Margin="2,0"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Nav" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="g" Background="Transparent">
              <Rectangle x:Name="bar" Width="2" HorizontalAlignment="Left" Fill="Transparent"/>
              <ContentPresenter VerticalAlignment="Center" Margin="24,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              </Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="g" Property="Background" Value="{DynamicResource Card}"/>
                <Setter TargetName="bar" Property="Fill" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{DynamicResource Accent}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/>
                <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Bg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"
                      Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Path x:Name="tick" Data="M 3,7.5 L 6.2,10.8 L 12.4,4" Stroke="{DynamicResource AccentInk}"
                      StrokeThickness="1.8" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Bg}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>

      <!-- ================= title bar ================= -->
      <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Panel}">
        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line}"/>
        <TextBlock x:Name="TxtPageTitle" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="24,0,0,0" Text="PLAY"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  Padding="11,4" VerticalAlignment="Center" Margin="0,0,14,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="DotServer" Width="6" Height="6" Fill="{DynamicResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="TxtServer" Foreground="{DynamicResource Ink}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Text="  " />
              <TextBlock x:Name="TxtPing" Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnMin"  Style="{StaticResource Chrome}" Content="&#x2013;"/>
          <Button x:Name="BtnMax"  Style="{StaticResource Chrome}" Content="&#x2610;"/>
          <Button x:Name="BtnClose" Style="{StaticResource Chrome}" Content="&#x2715;"/>
        </StackPanel>
      </Grid>

      <!-- ================= body ================= -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="196"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="24,0,20,18">
              <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,0,0,14"/>
              <TextBlock x:Name="TxtVersion" Foreground="{DynamicResource Faint}" FontSize="10.5" FontFamily="Consolas"/>
              <TextBlock x:Name="TxtBuildLine" Foreground="{DynamicResource Faint}" FontSize="10.5" FontFamily="Consolas" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Margin="0,14,0,0">
              <Button x:Name="NavPlay" Style="{StaticResource Nav}" Tag="on">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 2,1 L 13,7.5 L 2,14 Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <TextBlock Text="Play" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavMods" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 7.5,0.5 L 14.5,4.2 L 7.5,7.9 L 0.5,4.2 Z M 0.5,7.6 L 7.5,11.3 L 14.5,7.6 L 7.5,3.9 Z M 0.5,11 L 7.5,14.7 L 14.5,11 L 7.5,7.3 Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <TextBlock Text="Mods" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavSettings" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 0.5,3.5 H 14.5 M 0.5,11.5 H 14.5"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                  <TextBlock Text="Settings" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavHelp" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center"
                        Data="M 4.6,4.8 A 3,3 0 1 1 7.6,8.4 L 7.6,10.2 M 7.6,12.6 L 7.6,13.2"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                  <TextBlock Text="Help" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1">

          <!-- ================ PLAY ================ -->
          <Grid x:Name="PagePlay">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="228" ClipToBounds="True">
              <Rectangle>
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
                    <GradientStop Color="#0B1219" Offset="0"/>
                    <GradientStop Color="#16262E" Offset="0.55"/>
                    <GradientStop Color="#274249" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Ellipse Width="54" Height="54" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,86,0" Opacity="0.9">
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Color="#FFF2E0" Offset="0.5"/>
                    <GradientStop Color="#30FFE9C8" Offset="0.8"/>
                    <GradientStop Color="#00FFE9C8" Offset="1"/>
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Viewbox Stretch="Fill" VerticalAlignment="Bottom" Height="168">
                <Canvas Width="1000" Height="200">
                  <Path Data="M -10,210 L -10,58.5 L 37.4,58.5 L 63.5,105.6 L 88.8,114.1 L 131.3,74.8 L 173.3,111.9 L 206.2,90.4 L 255.1,89.6 L 280.0,107.5 L 309.3,68.5 L 369.1,60.5 L 420.8,100.8 L 446.4,71.4 L 500.1,106.9 L 549.4,107.3 L 608.3,108.7 L 657.1,92.3 L 713.0,49.0 L 741.1,95.3 L 770.7,114.1 L 823.8,100.1 L 886.3,97.0 L 936.1,103.2 L 997.0,102.7 L 1000,57.1 L 1010,57.1 L 1010,210 Z"  Fill="#1C333C" Opacity="0.85"/>
                  <Path Data="M -10,210 L -10,128.5 L 50.9,128.5 L 71.7,139.5 L 108.5,110.6 L 142.3,103.8 L 161.0,97.1 L 193.9,132.2 L 224.6,95.2 L 263.5,134.9 L 316.0,131.6 L 347.0,133.9 L 376.1,103.3 L 419.6,138.9 L 460.4,111.0 L 489.8,144.8 L 511.8,114.6 L 539.4,130.2 L 569.1,142.6 L 597.9,136.6 L 625.0,95.2 L 668.1,143.8 L 705.4,135.5 L 757.0,90.2 L 776.9,148.9 L 823.6,126.6 L 870.3,136.8 L 923.4,141.3 L 976.1,144.9 L 996.6,144.8 L 1000,144.3 L 1010,144.3 L 1010,210 Z"  Fill="#132630"/>
                  <Path Data="M -10,210 L -10,169.8 L 55.2,169.8 L 100.8,172.1 L 155.6,177.8 L 201.7,143.3 L 279.2,173.2 L 325.7,182.9 L 394.0,180.0 L 476.2,166.4 L 538.3,173.4 L 576.0,180.7 L 626.5,155.9 L 674.7,148.7 L 749.7,177.4 L 783.4,184.5 L 823.3,173.6 L 852.8,177.4 L 902.7,148.5 L 936.2,172.9 L 998.9,166.9 L 1000,149.0 L 1010,149.0 L 1010,210 Z" Fill="#0B141A"/>
                </Canvas>
              </Viewbox>
              <Rectangle>
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="#E60E1216" Offset="0"/>
                    <GradientStop Color="#000E1216" Offset="0.7"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line}"/>
              <StackPanel VerticalAlignment="Bottom" Margin="34,0,0,26">
                <TextBlock Text="SKYRIM TOGETHER" Foreground="#F4F8FA" FontSize="30" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="2,9,0,0">
                  <Rectangle Width="26" Height="2" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <TextBlock x:Name="TxtHeroLine" Foreground="#A6B6BF" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <Grid Margin="34,26,34,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="READY TO LAUNCH" Style="{StaticResource Eyebrow}"/>
                  <StackPanel x:Name="StatusList"/>
                  <Border x:Name="UpdateBar" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Accent}"
                          BorderThickness="1" Padding="16,13" Margin="0,18,0,0" Visibility="Collapsed">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtUpdateTitle" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="SemiBold" Text="Update available"/>
                        <TextBlock x:Name="TxtUpdateNote" Style="{StaticResource Body}" FontSize="11.5" Margin="0,3,0,0"/>
                      </StackPanel>
                      <Button x:Name="BtnUpdate" Grid.Column="1" Style="{StaticResource Ghost}" Content="Install" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </Grid>
                  </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="FIRST TIME" Style="{StaticResource Eyebrow}"/>
                  <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16,14">
                    <StackPanel>
                      <TextBlock Style="{StaticResource Body}" Text="Create a character and name it after yourself. That name is what other people see above your head, and it cannot be changed later without a new character."/>
                      <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Text="Save once before connecting. Joining from an unsaved game drops you back to the menu."/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="34,4,34,26">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="330"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="BtnPlay" Grid.Column="0" Style="{StaticResource Primary}" Content="PLAY"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnRecheck" Style="{StaticResource Ghost}" Content="Recheck" Margin="0,0,8,0"/>
                <Button x:Name="BtnCopy"    Style="{StaticResource Ghost}" Content="Copy address"/>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- ================ MODS ================ -->
          <Grid x:Name="PageMods" Visibility="Collapsed" Margin="34,26,34,20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" x:Name="VerifyCard" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" Padding="18,15">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="DotVerify" Grid.Column="0" Width="9" Height="9" Fill="{DynamicResource Faint}"
                         VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="TxtVerifyTitle" Foreground="{DynamicResource Ink}" FontSize="13.5" FontWeight="SemiBold" Text="Not checked yet"/>
                  <TextBlock x:Name="TxtVerifyNote" Style="{StaticResource Body}" FontSize="11.5" Margin="0,3,0,0"
                             Text="Compares what you have against the list the server expects."/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="BtnScan" Style="{StaticResource Ghost}" Content="Scan" Margin="0,0,8,0"/>
                  <Button x:Name="BtnFix"  Style="{StaticResource Ghost}" Content="Fix" IsEnabled="False"/>
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,20,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="TabPlugins" Style="{StaticResource Ghost}" Content="Server list" Margin="0,0,8,0"/>
                <Button x:Name="TabSkse"    Style="{StaticResource Ghost}" Content="Script extender" Margin="0,0,8,0"/>
                <Button x:Name="TabMine"    Style="{StaticResource Ghost}" Content="Your own"/>
              </StackPanel>
              <TextBox x:Name="BoxSearch" Grid.Column="1" Style="{StaticResource Field}" Margin="16,0,0,0"/>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
              <TextBlock x:Name="TxtModCount" Style="{StaticResource Body}"/>
              <Border x:Name="MineCard" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                      Padding="18,15" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Style="{StaticResource Body}" Text="Anything you drop in the folder below is copied into the game every time you press Play. Textures, meshes, sounds and music are safe, because the server only compares plugin lists and never sees them. A plugin here (.esp, .esm or .esl) will get you rejected when you connect, and the scan above will flag it."/>
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="BtnOpenMine" Style="{StaticResource Ghost}" Content="Open the folder" Margin="0,0,8,0"/>
                    <Button x:Name="BtnRefreshMine" Style="{StaticResource Ghost}" Content="Refresh"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
              <StackPanel x:Name="ModList"/>
            </ScrollViewer>
          </Grid>

          <!-- ================ SETTINGS ================ -->
          <Grid x:Name="PageSettings" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="34,28,34,28" MaxWidth="760" HorizontalAlignment="Left">

                <TextBlock Text="APPEARANCE" Style="{StaticResource Eyebrow}"/>
                <StackPanel x:Name="ThemeRow" Orientation="Horizontal" Margin="0,0,0,26"/>

                <TextBlock Text="SERVER" Style="{StaticResource Eyebrow}"/>
                <Grid Margin="0,0,0,26">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="110"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="BoxAddress" Grid.Column="0" Style="{StaticResource Field}" FontFamily="Consolas"/>
                  <TextBox x:Name="BoxPort"    Grid.Column="2" Style="{StaticResource Field}" FontFamily="Consolas"/>
                  <Button  x:Name="BtnSaveServer" Grid.Column="4" Style="{StaticResource Ghost}" Content="Save"/>
                </Grid>

                <TextBlock Text="UPDATES" Style="{StaticResource Eyebrow}"/>
                <StackPanel Margin="0,0,0,26">
                  <CheckBox x:Name="ChkAutoUpdate" Foreground="{DynamicResource Ink}" FontSize="12.5"
                            Content="Check for updates when the launcher opens"/>
                  <TextBlock x:Name="TxtUpdateSource" Style="{StaticResource Body}" Margin="0,9,0,0" FontFamily="Consolas" FontSize="11"/>
                  <Button x:Name="BtnCheckNow" Style="{StaticResource Ghost}" Content="Check now" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>

                <TextBlock Text="FOLDERS" Style="{StaticResource Eyebrow}"/>
                <StackPanel x:Name="PathRows" Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                  <Button x:Name="BtnFolder"  Style="{StaticResource Ghost}" Content="Open install folder" Margin="0,0,8,0"/>
                  <Button x:Name="BtnOpenLog" Style="{StaticResource Ghost}" Content="Open log" Margin="0,0,8,0"/>
                  <Button x:Name="BtnOpenSaves" Style="{StaticResource Ghost}" Content="Open saves"/>
                </StackPanel>

                <TextBlock Text="MAINTENANCE" Style="{StaticResource Eyebrow}"/>
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="18,16">
                  <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Repair settings" FontSize="13.5"/>
                    <TextBlock Style="{StaticResource Body}" Text="Puts the game settings and load order back to the versions that shipped with this build. Use it if the game stops loading the right mods, or after you have changed something you cannot undo."/>
                    <Button x:Name="BtnRepair" Style="{StaticResource Ghost}" Content="Repair" HorizontalAlignment="Left" Margin="0,12,0,0"/>

                    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,20,0,20"/>

                    <TextBlock Style="{StaticResource H2}" Text="Restore Windows folders" FontSize="13.5"/>
                    <TextBlock Style="{StaticResource Body}" Text="While the game runs, Windows' Skyrim settings and saves folders point at this build and are put back when you quit. If the game crashed hard and something still looks redirected, this undoes it by hand."/>
                    <Button x:Name="BtnRestore" Style="{StaticResource Ghost}" Content="Restore" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- ================ HELP ================ -->
          <Grid x:Name="PageHelp" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="HelpList" Margin="34,28,34,28" MaxWidth="800" HorizontalAlignment="Left"/>
            </ScrollViewer>
          </Grid>

        </Grid>
      </Grid>

      <!-- ================= status bar ================= -->
      <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
        <Grid Margin="18,0">
          <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource Muted}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtStatusRight" Foreground="{DynamicResource Faint}" FontSize="11" FontFamily="Consolas"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
