                    <StackPanel x:Name="PnlOwnGame">
                      <TextBlock Style="{StaticResource H2}" Text="Thornswood's own Skyrim folder"/>
                      <TextBlock Style="{StaticResource Body}" Text="Runs Thornswood from a Skyrim folder of its own, made from what Vortex has deployed while the Thornswood profile is on. Keizaal, Daedric and any other Vortex profile can then use the Steam copy or folders of their own without reaching Thornswood, and switching profiles in Vortex no longer takes Thornswood's mods away. The big files are links to Vortex's copies, so the collection is not on the disk twice. When Vortex deploys a newer Thornswood collection, the launcher brings it in by itself the next time it starts. Windows asks for administrator once while this is set up, to write a firewall rule for the game's browser: Skyrim Platform draws the interface in a second program, and a rule is tied to a program's path, so moving the game into its own folder is what makes Windows ask about it. The rule is a block, because that program only ever talks to the game on this machine. Saying no is fine and only means Windows asks you about the browser on the first launch instead."/>
                      <TextBlock x:Name="TxtOwnGameState" Style="{StaticResource Small}" Margin="0,8,0,0"/>
                      <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                        <Button x:Name="BtnOwnGameMake" Style="{StaticResource Ghost}" Content="Make it" Margin="0,0,8,0"/>
                        <Button x:Name="BtnOwnGameRefresh" Style="{StaticResource Ghost}" Content="Bring it up to date from Vortex"/>
                      </StackPanel>

                      <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,22,0,22"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource H2}" Text="Repair"/>
                    <TextBlock Style="{StaticResource Body}" Text="Puts this build's own files back: the settings and load order that shipped with it, the client and the overlays under Data, the mod settings this build pins, and the class preset names. Another server's launcher can replace any of those, and an install that has never taken an update has never had a spare copy of them. This is everything Play does on the way in, done on demand, and it is safe to press twice. Close Skyrim first."/>
                    <Button x:Name="BtnRepair" Style="{StaticResource Ghost}" Content="Repair" HorizontalAlignment="Left" Margin="0,13,0,0"/>

                    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,22,0,22"/>

                    <TextBlock Style="{StaticResource H2}" Text="Restore Windows folders"/>
                    <TextBlock Style="{StaticResource Body}" Text="While the game runs, Windows' Skyrim settings and saves folders point at this build and are put back when you quit. If the game crashed hard and something still looks redirected, this undoes it by hand."/>
                    <Button x:Name="BtnRestore" Style="{StaticResource Ghost}" Content="Restore" HorizontalAlignment="Left" Margin="0,13,0,0"/>

                    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,22,0,22"/>

                    <TextBlock Style="{StaticResource H2}" Text="Refresh the shortcut icon"/>
                    <TextBlock Style="{StaticResource Body}" Text="The launcher repoints your shortcut at the current artwork every time it starts, which is usually enough. This is for when the desktop or the taskbar is still showing an old icon anyway. Explorer restarts, so the taskbar blinks once. Nothing is lost."/>
                    <Button x:Name="BtnIcons" Style="{StaticResource Ghost}" Content="Refresh icon" HorizontalAlignment="Left" Margin="0,13,0,0"/>

                    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,22,0,22"/>

                    <StackPanel x:Name="PnlDev">
                      <TextBlock Style="{StaticResource H2}" Text="The dev build"/>
                      <TextBlock Style="{StaticResource Body}" Text="A second launcher beside this one, in its own folder with its own Start menu entry. It gets new changes first and joins the dev server, so things get broken there instead of here. Same Skyrim, same mods; each launcher puts its own files back before it plays. Characters on the dev server are separate, and they are throwaway. The Owner and Dev roles only."/>
                      <TextBlock x:Name="TxtDevState" Style="{StaticResource Small}" Margin="0,8,0,0"/>
                      <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                        <Button x:Name="BtnDevInstall" Style="{StaticResource Ghost}" Content="Install the dev build" Margin="0,0,8,0"/>
                        <Button x:Name="BtnDevRemove" Style="{StaticResource Ghost}" Content="Remove the dev build"/>
                      </StackPanel>

                      <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,22,0,22"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource H2}" Text="Uninstall ThornsWood"/>
                    <TextBlock Style="{StaticResource Body}" Text="Puts your Windows Skyrim folders back, then deletes this build and the launcher with it. Your own Skyrim in Steam is never touched: this is a separate copy and Steam does not know it exists. There is no undo, and the whole thing has to be downloaded again afterwards."/>
                    <CheckBox x:Name="ChkDeleteMods" Content="Delete the mods as well" Margin="0,13,0,0" IsChecked="True"/>
                    <TextBlock Style="{StaticResource Small}" Margin="28,6,0,0" Text="Untick this and the Game folder stays exactly where it is. Reinstalling then reuses what is already on the disk instead of pulling the whole collection down again, which is the difference between a few minutes and an evening."/>
                    <CheckBox x:Name="ChkKeepSaves" Content="Keep this build's saves and settings" Margin="0,13,0,0" IsChecked="True"/>
                    <TextBlock Style="{StaticResource Small}" Margin="28,6,0,0" Text="Leaves the Profile folder where it is, so a reinstall picks your characters and settings back up."/>
                    <Button x:Name="BtnUninstall" Style="{StaticResource Ghost}" Content="Uninstall ThornsWood" HorizontalAlignment="Left" Margin="0,15,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

        </Grid>
      </Grid>

      <!-- ================= status bar ================= -->
      <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
        <Grid Margin="20,0">
          <TextBlock x:Name="TxtStatus" Style="{StaticResource Mono}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,180,0"/>
          <TextBlock x:Name="TxtStatusRight" Style="{StaticResource Mono}" Foreground="{DynamicResource Faint}" FontSize="11"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
      </Border>

      <!-- ================= in window dialogs =================
           Character creation used to be its own top level window. That is a
           second thing to alt tab past, it lands wherever Windows decides,
           and anybody capturing the launcher window rather than the whole
           screen loses the entire of character creation off their stream.
           It goes in here instead, over everything including the title bar.
           ============================================================== -->
      <Grid x:Name="Overlay" Grid.RowSpan="3" Panel.ZIndex="99" Visibility="Collapsed"
            Background="#D00A0807">
        <Border x:Name="OverlayHost"/>
      </Grid>

    </Grid>
  </Border>
</Window>
