<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The release note rules (scripts/release/Note-Rules.ps1, #5179), in C# on
    .NET 10: the plan's rev 64 ports the release tools to C# one step at a
    time. This is the first step: the rules, and the pull request body check
    that .github/workflows/pr-body.yml runs, which scripts/dev/Check-PrBody.ps1
    was. Program.cs says what the command takes, and NoteRules.cs what the
    rules refuse.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>thornswood-notes</AssemblyName>
    <RootNamespace>Thornswood.ReleaseNotes</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ReleaseNotes.Tests" />
  </ItemGroup>
</Project>
